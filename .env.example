# 量化交易系统 — 环境配置模板
# 复制此文件为 .env 并填入实际值

# ── 管理员密码（可选）──
ADMIN_PASSWORD=

# ── 默认代理（可选，用户可覆盖）──
PROXY_URL=

# ── 服务器（可选）──
SERVER_HOST=localhost
UI_PORT=8000

# ── 默认策略参数 ──
SYMBOLS=ETHUSDT,BTCUSDT
STRATEGY_TYPE=TEMA
TIMEFRAME_MINUTES=1
MA_TYPE=TEMA
MA_LEN=8
CROSS_MULT=3
DELAY_MINUTES=5
POSITION_PCT=60
LEVERAGE=3
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=1.5
TRADE_TYPE=BOTH
MAX_ORDER_USDT=0
MIN_ORDER_USDT=11
MARGIN_MODE=isolated
