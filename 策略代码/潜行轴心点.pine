//@version=5
strategy("潜行轴心点策略", overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         pyramiding=0,
         max_lines_count=500,
         max_labels_count=500)

// ========== 参数 ==========
atrPeriod      = input.int(14, "ATR周期", minval=5, maxval=50)
zoneTolMult    = input.float(0.3, "区域容差(ATR倍数)", minval=0.1, maxval=2.0, step=0.1)
strongBodyMult = input.float(1.5, "强势K线实体倍数", minval=1.0, maxval=5.0, step=0.1)
lookbackBars   = input.int(96, "摆动回看K线数", minval=24, maxval=500, tooltip="向左回看N根K线找摆动高/低点，默认96=24小时")
useSwingLevels = input.bool(true, "启用摆动高低点", tooltip="在区间高低点之外，额外使用摆动高低点作为买卖线")
rrRatio        = input.float(2.0, "盈亏比", minval=1.0, maxval=5.0, step=0.1)
showLines      = input.bool(true, "显示买卖四线")
showSignals    = input.bool(true, "显示信号标记")

// ========== 北京时间 00:00-24:00 当日区间高低点 ==========
// 用 GMT+8 时区检测换日（跨自然日零点）
cnDay = dayofmonth("GMT+8")
cnDayPrev = cnDay[1]
isNewCnDay = cnDay != cnDayPrev

var float curDayHigh = 0.0
var float curDayLow  = 1e18
var float prevDayHigh = 0.0
var float prevDayLow  = 1e18

if barstate.isfirst
    curDayHigh := high
    curDayLow  := low
    prevDayHigh := high
    prevDayLow  := low
else if isNewCnDay
    prevDayHigh := curDayHigh
    prevDayLow  := curDayLow
    curDayHigh  := high
    curDayLow   := low
else
    curDayHigh := math.max(curDayHigh, high)
    curDayLow  := math.min(curDayLow, low)

// 区间高低点 = 上一个北京时间自然日的最高/最低价
rangeHigh = prevDayHigh
rangeLow  = prevDayLow

// ========== 摆动高低点（向左回看N根K线） ==========
sHigh = ta.highest(high, lookbackBars + 1)
sLow  = ta.lowest(low,  lookbackBars + 1)

// ========== ATR ==========
atrVal  = ta.atr(atrPeriod)
zoneTol = atrVal * zoneTolMult

// ========== 买卖四线 ==========
sellLine1 = rangeHigh                                       // 区间高点 → 卖出线1
sellLine2 = useSwingLevels ? math.max(rangeHigh, sHigh) : na // 摆动高点 → 卖出线2
buyLine1  = rangeLow                                        // 区间低点 → 买入线1
buyLine2  = useSwingLevels ? math.min(rangeLow, sLow) : na  // 摆动低点 → 买入线2

// ========== K线强度判断 ==========
body    = math.abs(close - open)
avgBody = ta.sma(body, 20)
isStrong = body > avgBody * strongBodyMult

// ========== 价格到达区域判断 ==========
isAtBuyZone(_low) =>
    near1 = math.abs(_low - buyLine1) <= zoneTol
    near2 = useSwingLevels and math.abs(_low - buyLine2) <= zoneTol
    near1 or near2

isAtSellZone(_high) =>
    near1 = math.abs(_high - sellLine1) <= zoneTol
    near2 = useSwingLevels and math.abs(_high - sellLine2) <= zoneTol
    near1 or near2

// ========== 做多信号（3K线模式） ==========
// K1: 强势阴线到达买入区域
strongBearToBuy = isStrong and close < open and isAtBuyZone(low)
// K2: 反转阳线
revBull = close > open and strongBearToBuy[1]
// K3: 在K2收盘时挂stop买单于K2最高价，K3期间价格突破即成交（潜行轴）

// ========== 做空信号（3K线模式） ==========
// K1: 强势阳线到达卖出区域
strongBullToSell = isStrong and close > open and isAtSellZone(high)
// K2: 反转阴线
revBear = close < open and strongBullToSell[1]
// K3: 在K2收盘时挂stop卖单于K2最低价，K3期间价格突破即成交

// ========== 执行交易 ==========
// 做多：反转K线收盘后，在K2最高价挂stop买单
if revBull and strategy.position_size <= 0
    triggerPrice = high              // K2最高价 = 潜行轴
    slLevel = math.min(low[1], low)  // K1和K2最低影线 = 止损
    tpLevel = triggerPrice + (triggerPrice - slLevel) * rrRatio
    strategy.cancel_all()
    strategy.entry("Long", strategy.long, stop=triggerPrice)
    strategy.exit("Long Exit", "Long", stop=slLevel, limit=tpLevel)

// 做空：反转K线收盘后，在K2最低价挂stop卖单
if revBear and strategy.position_size >= 0
    triggerPrice = low               // K2最低价 = 潜行轴
    slLevel = math.max(high[1], high) // K1和K2最高影线 = 止损
    tpLevel = triggerPrice - (slLevel - triggerPrice) * rrRatio
    strategy.cancel_all()
    strategy.entry("Short", strategy.short, stop=triggerPrice)
    strategy.exit("Short Exit", "Short", stop=slLevel, limit=tpLevel)

// ========== 绘图 ==========
// 买卖四线
plot(showLines ? sellLine1 : na, "区间高点", color=color.new(color.red, 0), linewidth=1, style=plot.style_circles)
plot(showLines ? buyLine1  : na, "区间低点", color=color.new(color.green, 0), linewidth=1, style=plot.style_circles)
plot(showLines and useSwingLevels ? sellLine2 : na, "摆动高点", color=color.new(color.maroon, 40), linewidth=1, style=plot.style_circles)
plot(showLines and useSwingLevels ? buyLine2  : na, "摆动低点", color=color.new(color.teal, 40), linewidth=1, style=plot.style_circles)

// 区域背景色
bgColorBuy  = isAtBuyZone(low)  ? color.new(color.green, 93) : na
bgColorSell = isAtSellZone(high) ? color.new(color.red, 93)   : na
bgcolor(bgColorBuy,  title="买入区域")
bgcolor(bgColorSell, title="卖出区域")

// 信号标记
plotshape(showSignals and strongBearToBuy,   "1强阴到买区", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(showSignals and strongBullToSell,  "1强阳到卖区", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(showSignals and revBull,           "2反转阳", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(showSignals and revBear,           "2反转阴", shape.triangledown, location.abovebar, color.orange, size=size.small)

// K2上标注潜行轴触发价和止损
if showSignals and revBull
    sl = math.min(low[1], low)
    label.new(bar_index, high, "潜行轴买入@" + str.tostring(high, "#.##") + "\n止损@" + str.tostring(sl, "#.##"),
              color=color.green, textcolor=color.white, style=label.style_label_down, size=size.small)
if showSignals and revBear
    sl = math.max(high[1], high)
    label.new(bar_index, low, "潜行轴卖出@" + str.tostring(low, "#.##") + "\n止损@" + str.tostring(sl, "#.##"),
              color=color.red, textcolor=color.white, style=label.style_label_up, size=size.small)

// ========== 信息面板 ==========
var table infoTable = table.new(position.top_right, 3, 5,
                                 bgcolor=color.new(color.black, 80),
                                 border_color=color.new(color.white, 30),
                                 border_width=1)
if barstate.islast
    table.cell(infoTable, 0, 0, "潜行轴心点策略", text_color=color.yellow, text_size=size.large)
    table.cell(infoTable, 0, 1, "买入线1（区间低）", text_color=color.white)
    table.cell(infoTable, 1, 1, str.tostring(buyLine1, "#.##"), text_color=color.green)
    table.cell(infoTable, 0, 2, "买入线2（摆动低）", text_color=color.white)
    table.cell(infoTable, 1, 2, useSwingLevels ? str.tostring(buyLine2, "#.##") : "未启用", text_color=color.teal)
    table.cell(infoTable, 0, 3, "卖出线1（区间高）", text_color=color.white)
    table.cell(infoTable, 1, 3, str.tostring(sellLine1, "#.##"), text_color=color.red)
    table.cell(infoTable, 0, 4, "卖出线2（摆动高）", text_color=color.white)
    table.cell(infoTable, 1, 4, useSwingLevels ? str.tostring(sellLine2, "#.##") : "未启用", text_color=color.maroon)
